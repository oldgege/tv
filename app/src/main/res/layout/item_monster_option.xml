<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/monster_card_width"
    android:layout_height="@dimen/monster_card_height"
    android:focusable="true"
    android:clickable="true"
    android:background="@android:color/transparent"
    android:padding="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 圆形身体 --> 
    <ImageView
        android:id="@+id/iv_monster_body"
        android:layout_width="@dimen/monster_body_size"
        android:layout_height="@dimen/monster_body_size"
        android:layout_centerInParent="true"
        android:src="@drawable/monster_body_1" />

    <!-- 左眼 -->
    <View
        android:id="@+id/eye_left"
        android:layout_width="@dimen/monster_eye_size"
        android:layout_height="@dimen/monster_eye_size"
        android:layout_marginTop="@dimen/monster_eye_margin_top"
        android:layout_marginStart="@dimen/monster_eye_margin_side"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/eye_white" />

    <!-- 右眼 -->
    <View
        android:id="@+id/eye_right"
        android:layout_width="@dimen/monster_eye_size"
        android:layout_height="@dimen/monster_eye_size"
        android:layout_marginTop="@dimen/monster_eye_margin_top"
        android:layout_marginEnd="@dimen/monster_eye_margin_side"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/eye_white" />

    <!-- 选项文字 -->
    <TextView
        android:id="@+id/tv_option_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="选项"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/option_text_size"
        android:textStyle="bold"
        android:gravity="center"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="6" />

</RelativeLayout>